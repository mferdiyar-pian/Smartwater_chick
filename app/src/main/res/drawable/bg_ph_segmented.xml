    </item>
    <item android:left="80dp" android:right="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#28C76F"/>
        </shape>
    </item>
    <item android:left="240dp">
        <shape android:shape="rectangle">
            <corners android:topRightRadius="8dp" android:bottomRightRadius="8dp"/>
