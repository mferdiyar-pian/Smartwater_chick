<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6FB">

    <!-- TOP APP BAR -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_header"
        app:elevation="4dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Left: Grid Icon + Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_grid"
                    android:tint="#FFFFFF"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monitor Kualitas Air"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Right: Bell + Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end|center_vertical">

                <ImageView
                    android:id="@+id/ivNotification"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_notification"
                    android:tint="#FFFFFF"
                    android:layout_marginEnd="16dp"
                    android:clickable="true"
                    android:focusable="true" />

                <ImageView
                    android:id="@+id/ivSettings"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_settings"
                    android:tint="#FFFFFF"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </androidx.appcompat.widget.Toolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- SCROLLABLE CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="72dp"
        android:clipToPadding="false"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- CARD 1: Status pH Terkini -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <!-- Header Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_water_drop"
                            android:tint="#2ECC71"
                            android:background="@drawable/bg_icon_green"
                            android:padding="4dp"
                            android:layout_marginEnd="10dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Status pH Terkini"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E" />

                        <TextView
                            android:id="@+id/tvPhValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7.2 pH"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textColor="@color/blue_primary" />
                    </LinearLayout>

                    <!-- pH Scale Bar -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="ASAM"
                            android:textSize="10sp"
                            android:textColor="#E74C3C" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="NETRAL"
                            android:textSize="10sp"
                            android:textColor="#2ECC71"
                            android:gravity="center" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="BASA"
                            android:textSize="10sp"
                            android:textColor="#3498DB"
                            android:gravity="end" />
                    </LinearLayout>

                    <!-- Gradient pH Bar -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="12dp"
                        android:layout_marginBottom="6dp">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="12dp"
                            android:background="@drawable/bg_ph_gradient"
                            android:layout_gravity="center_vertical" />

                        <!-- Indicator dot at 7.2 (roughly 51% of bar) -->
                        <View
                            android:id="@+id/ivPhIndicator"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:background="@drawable/bg_ph_indicator"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="165dp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="7.2 pH"
                        android:textSize="11sp"
                        android:textColor="#8A8FA8"
                        android:gravity="center" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD ROW: Kapasitas Air + Status Irigasi -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- Kapasitas Air -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp"
                    android:layout_marginEnd="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:src="@drawable/ic_water_drop"
                                android:tint="@color/blue_primary"
                                android:background="@drawable/bg_icon_blue"
                                android:padding="4dp" />

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                android:text="-1.2%"
                                android:textSize="12sp"
                                android:textColor="#E74C3C" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kapasitas Air"
                            android:textSize="12sp"
                            android:textColor="#8A8FA8"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvWaterCapacity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="65%"
                            android:textSize="28sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Status Irigasi -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="3dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:background="#FFFFFF">

                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:src="@drawable/ic_irrigation"
                            android:tint="#F39C12"
                            android:background="@drawable/bg_icon_orange"
                            android:padding="4dp"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Status Irigasi"
                            android:textSize="12sp"
                            android:textColor="#8A8FA8"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tvIrrigationStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aktif"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- CARD: Peringatan Kritis -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Peringatan Kritis"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E" />

                        <!-- Badge -->
                        <TextView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:text="1"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="#FFFFFF"
                            android:background="@drawable/bg_badge_red"
                            android:gravity="center" />
                    </LinearLayout>

                    <!-- Alert Box -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_alert_box"
                        android:padding="12dp"
                        android:gravity="top"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_warning"
                            android:tint="#E74C3C"
                            android:layout_marginEnd="10dp"
                            android:layout_marginTop="2dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="pH Air Tidak Normal"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#C0392B"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tvAlertMessage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Kadar pH di Tangki 1 adalah 5.5, di bawah ambang batas. Siklus penyesuaian otomatis sedang berjalan."
                                android:textSize="12sp"
                                android:textColor="#8A8FA8"
                                android:lineSpacingMultiplier="1.3" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGantiAir"
                            android:layout_width="0dp"
                            android:layout_height="64dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="12dp"
                            android:background="@drawable/bg_button_primary"
                            android:text="Ganti air sekarang"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            app:backgroundTint="@null"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_water_drop"
                            app:iconGravity="textStart"
                            app:iconPadding="10dp"
                            app:iconTint="#FFFFFF"
                            app:rippleColor="@android:color/transparent" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAbaikan"
                            android:layout_width="150dp"
                            android:layout_height="64dp"
                            android:background="@drawable/bg_button_outline"
                            android:text="Abaikan"
                            android:textAllCaps="false"
                            android:textColor="#C62828"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:paddingStart="20dp"
                            android:paddingEnd="20dp"
                            app:backgroundTint="@null"
                            app:cornerRadius="14dp"
                            app:rippleColor="@android:color/transparent"
                            app:strokeColor="#F3A6AF"
                            app:strokeWidth="1dp" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- CARD: Riwayat Kadar pH Chart -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:background="#FFFFFF">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Riwayat Kadar pH"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="#1A1A2E" />

                        <TextView
                            android:id="@+id/tvLihatDetail"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lihat detail"
                            android:textSize="13sp"
                            android:textColor="@color/blue_primary"
                            android:clickable="true"
                            android:focusable="true" />
                    </LinearLayout>

                    <!-- Chart View -->
                    <com.example.smartwaterchick.PhChartView
                        android:id="@+id/phChartView"
                        android:layout_width="match_parent"
                        android:layout_height="140dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        app:menu="@menu/bottom_nav_menu"
        app:labelVisibilityMode="labeled"
        app:itemTextColor="@color/nav_item_color"
        app:itemIconTint="@color/nav_item_color"
        app:elevation="8dp" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>