<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/blue_header"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@color/blue_header"
        android:paddingTop="20dp" android:paddingBottom="20dp"
        android:paddingStart="20dp" android:paddingEnd="20dp"
        android:gravity="center_vertical">
        <FrameLayout
            android:id="@+id/btnBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_edit_button"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:clickable="true" android:focusable="true">
            <ImageView
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_arrow_back" android:tint="#FFFFFF"
                android:layout_gravity="center"/>
        </FrameLayout>
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Pusat Bantuan"
            android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="@color/bg_screen"
        android:clipToPadding="false" android:paddingBottom="40dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <!-- Banner -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:background="@color/blue_header" android:padding="16dp"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="48dp" android:layout_height="48dp"
                        android:src="@drawable/ic_help" android:tint="#FFFFFF"
                        android:layout_marginEnd="14dp"/>
                    <LinearLayout
                        android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Selamat Datang di Pusat Bantuan"
                            android:textColor="#FFFFFF" android:textSize="15sp" android:textStyle="bold"/>
                        <TextView
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="Panduan lengkap penggunaan SmartWater Chick"
                            android:textColor="#C0D8F0" android:textSize="12sp"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 1. Login -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="1. MEMULAI APLIKASI"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="12dp">
                        <TextView
                            android:layout_width="28dp" android:layout_height="28dp"
                            android:text="1" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold"
                            android:gravity="center" android:background="@color/blue_header"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Buka Aplikasi &amp; Login"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Masukkan email dan password akun yang telah terdaftar, lalu tekan tombol Masuk."
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="3dp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="12dp"/>
                    <LinearLayout
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="28dp" android:layout_height="28dp"
                            android:text="2" android:textColor="#FFFFFF"
                            android:textSize="13sp" android:textStyle="bold"
                            android:gravity="center" android:background="@color/blue_header"
                            android:layout_marginEnd="12dp"/>
                        <LinearLayout
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:orientation="vertical">
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Tampilan Dashboard"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp" android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="Setelah login, Anda langsung masuk ke Beranda yang menampilkan status real-time sensor dan pompa."
                                android:textColor="@color/text_secondary" android:textSize="12sp"
                                android:layout_marginTop="3dp" android:lineSpacingExtra="2dp"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Dashboard -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="2. HALAMAN BERANDA"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📊  Volume Air Tangki"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Menampilkan kapasitas dan persentase air saat ini. Warna indikator: Hijau (aman), Kuning (perhatian), Merah (kritis)."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌡️  Suhu &amp; pH Air"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Data suhu dan pH diperbarui otomatis setiap beberapa detik langsung dari sensor ESP32 via Firebase."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⚡  Status Pompa"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Kartu pompa menampilkan status ON/OFF real-time. Pompa berjalan otomatis sesuai jadwal atau dikontrol manual."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Kontrol -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="3. HALAMAN KONTROL"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="💧  Kontrol Pompa Manual"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tekan tombol ON/OFF untuk mengaktifkan atau mematikan pompa secara langsung. Perintah dikirim ke ESP32 via Firebase."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="⏰  Jadwal Otomatis"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tekan tombol (+) untuk menambah jadwal. Atur waktu mulai dan durasi. Pompa akan menyala otomatis sesuai jadwal yang dibuat."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🪣  Level Tangki"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Animasi tangki menunjukkan persentase air secara visual dan real-time."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 4. Analisis -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="4. HALAMAN ANALISIS"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📈  Grafik Data"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Grafik menampilkan tren volume air, suhu, dan pH. Geser tab Harian / Mingguan / Bulanan untuk berpindah periode."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📥  Ekspor Laporan Excel"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Tekan 'Laporan Lengkap' untuk mengunduh data dalam format .xls. File tersimpan otomatis di folder Downloads."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 5. Perangkat -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="5. HALAMAN PERANGKAT"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="📡  Status Koneksi ESP32"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Menampilkan status koneksi perangkat ESP32. Ikon hijau = aktif dan terhubung. Ikon merah = offline."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🔧  Informasi Sensor"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Detail pembacaan sensor Ultrasonik, Suhu DS18B20, dan pH ditampilkan beserta waktu pembaruan terakhir."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 6. Pengaturan -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="6. HALAMAN PENGATURAN"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="20dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="👤  Edit Profil"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Ketuk ikon pensil untuk mengubah nama dan jabatan. Ketuk foto untuk mengganti dari galeri."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🌙  Mode Gelap"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Aktifkan toggle Mode Gelap untuk beralih ke tema gelap yang nyaman di malam hari."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="14dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="14dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="🗑️  Hapus Database"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Menghapus seluruh riwayat monitoring dari Firebase secara permanen. Tindakan ini tidak dapat dibatalkan."
                        android:textColor="#E74C3C" android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- FAQ -->
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="PERTANYAAN UMUM (FAQ)"
                android:textSize="12sp" android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="8dp" android:layout_marginBottom="8dp"
                android:letterSpacing="0.1"/>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent" android:layout_height="wrap_content"
                app:cardCornerRadius="16dp" app:cardElevation="0dp"
                android:layout_marginBottom="8dp">
                <LinearLayout
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:background="@color/bg_card"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="❓  Data tidak muncul di dashboard?"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Pastikan ESP32 menyala dan terhubung ke WiFi. Periksa koneksi internet ponsel Anda."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="16dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="16dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="❓  Pompa tidak merespon perintah?"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Cek status perangkat di halaman Perangkat. Jika offline, restart ESP32 dan tunggu 30 detik."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp" android:layout_marginBottom="16dp"/>
                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="#F0F2F8" android:layout_marginBottom="16dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="❓  Lupa password akun?"
                        android:textColor="@color/text_primary" android:textSize="14sp"
                        android:textStyle="bold" android:layout_marginBottom="4dp"/>
                    <TextView
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Hubungi administrator untuk reset password melalui Firebase Authentication console."
                        android:textColor="@color/text_secondary" android:textSize="12sp"
                        android:lineSpacingExtra="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
