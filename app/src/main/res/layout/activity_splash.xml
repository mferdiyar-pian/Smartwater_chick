<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B5BCE">

    <!-- Top Right Signal Icon -->
    <ImageView
        android:id="@+id/ivSignal"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:src="@drawable/ic_signal"
        android:tint="#FFFFFF"
        android:alpha="0.8" />

    <!-- Center Content -->
    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginBottom="80dp">

        <!-- Outer Circle -->
        <FrameLayout
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:layout_marginBottom="36dp">

            <!-- Outer ring -->
            <View
                android:layout_width="180dp"
                android:layout_height="180dp"
                android:background="@drawable/bg_circle_outer"
                android:layout_gravity="center" />

            <!-- Inner circle with icon -->
            <FrameLayout
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_circle_inner">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_water_drop"
                    android:tint="#FFFFFF" />
            </FrameLayout>
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Smart Water Chick"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.02"
            android:layout_marginBottom="10dp" />

        <!-- Tagline -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="INTELLIGENT WATER PH CONTROL FOR\nLIVESTOCK"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:alpha="0.75"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:lineSpacingMultiplier="1.4" />
    </LinearLayout>

    <!-- Bottom: Loading Bar + Bottom Nav -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="56dp"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp">

        <!-- LOADING text + percentage -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LOADING"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:alpha="0.8"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvPercent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:alpha="0.8" />
        </LinearLayout>

        <!-- Progress Bar Track -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="6dp">

            <!-- Track background -->
            <View
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:background="@drawable/bg_progress_track" />

            <!-- Progress fill -->
            <View
                android:id="@+id/viewProgress"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:background="@drawable/bg_progress_fill" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Navigation Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#1650B0"
        android:gravity="center_vertical">

        <!-- PH Monitoring -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_ph_monitoring"
                android:tint="#FFFFFF"
                android:alpha="0.7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PH&#10;MONITORING"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:alpha="0.7"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Critical Alerts -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_warning"
                android:tint="#FFFFFF"
                android:alpha="0.7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRITICAL&#10;ALERTS"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:alpha="0.7"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- PH History -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_analytics"
                android:tint="#FFFFFF"
                android:alpha="0.7" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PH&#10;HISTORY"
                android:textColor="#FFFFFF"
                android:textSize="8sp"
                android:alpha="0.7"
                android:gravity="center"
                android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>