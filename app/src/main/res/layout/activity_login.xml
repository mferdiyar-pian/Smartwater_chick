<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logo + App Name -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="40dp">

            <androidx.cardview.widget.CardView
                android:layout_width="90dp"
                android:layout_height="90dp"
                app:cardBackgroundColor="#1B5BCE"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <ImageView
                    android:layout_width="76dp"
                    android:layout_height="76dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_water"
                    android:scaleType="fitCenter"
                    android:contentDescription="Logo" />
            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SmartWaterChick"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"
                android:letterSpacing="-0.02" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sistem Monitoring Air Mandiri"
                android:textSize="14sp"
                android:textColor="#8A8FA8"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Login Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="32dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp"
                android:background="#FFFFFF">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selamat Datang"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Silakan masuk untuk mengelola kandang Anda"
                    android:textSize="14sp"
                    android:textColor="#8A8FA8"
                    android:layout_marginBottom="28dp" />

                <!-- Input Fields -->
                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="none">

                    <EditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Email Address"
                        android:inputType="textEmailAddress"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="15sp"
                        android:textColor="#1A1A2E"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_mail"
                        android:drawablePadding="12dp"
                        android:drawableTint="#8A8FA8" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:hintEnabled="false"
                    app:boxBackgroundMode="none"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="#8A8FA8">

                    <EditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:textSize="15sp"
                        android:textColor="#1A1A2E"
                        android:background="@drawable/bg_input_field"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="12dp"
                        android:drawableTint="#8A8FA8" />
                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lupa Password?"
                    android:textColor="#1B5BCE"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="end"
                    android:layout_marginBottom="28dp" />

                <!-- CAPTCHA Card (Standardized) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardCaptcha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F4F6FB"
                    android:layout_marginBottom="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:orientation="horizontal"
                        android:padding="12dp"
                        android:gravity="center_vertical">

                        <FrameLayout
                            android:id="@+id/flCaptchaBox"
                            android:layout_width="30dp"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_captcha_checkbox"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:id="@+id/ivCaptchaCheck"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_check_circle"
                                android:tint="#1B5BCE"
                                android:visibility="gone" />
                            <ProgressBar
                                android:id="@+id/pbCaptcha"
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_gravity="center"
                                android:indeterminateTint="#1B5BCE"
                                android:visibility="gone" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView
                                android:id="@+id/tvCaptchaLabel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Saya bukan robot"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E" />
                            <TextView
                                android:id="@+id/tvCaptchaStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ketuk untuk verifikasi"
                                android:textSize="11sp"
                                android:textColor="#8A8FA8" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_shield"
                            android:tint="#1B5BCE"
                            android:alpha="0.6" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Sign In Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignIn"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Masuk Sekarang"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:backgroundTint="#1B5BCE"
                    app:cornerRadius="12dp"
                    android:elevation="0dp"
                    android:layout_marginBottom="24dp" />

                <!-- OR Divider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="24dp">
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#F0F2F8" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="  Atau masuk dengan  " android:textSize="12sp" android:textColor="#8A8FA8" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="#F0F2F8" />
                </LinearLayout>

                <!-- Google Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGoogle"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Google"
                    android:textAllCaps="false"
                    android:textColor="#1A1A2E"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:backgroundTint="#F4F6FB"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_google"
                    app:iconTint="@null"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    android:elevation="0dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Sign Up Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="32dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Belum punya akun? "
                android:textSize="14sp"
                android:textColor="#8A8FA8" />
            <TextView
                android:id="@+id/tvSignUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Daftar di sini"
                android:textSize="14sp"
                android:textColor="#1B5BCE"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>