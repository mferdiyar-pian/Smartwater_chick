<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SmartWaterChick" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/blue_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/blue_light</item>
        <item name="colorOnSecondary">@color/blue_primary</item>

        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/blue_header</item>
    </style>

    <style name="Theme.SmartWaterChick" parent="Base.Theme.SmartWaterChick" />
    <style name="Theme.SmartWaterChick.NoActionBar" parent="Theme.SmartWaterChick">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.SmartWaterChick.Splash" parent="Theme.SmartWaterChick.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
    </style>

    <!-- Custom text appearance for Bottom Navigation to reduce text cramping -->
    <style name="BottomNavTextAppearance" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textSize">10sp</item>
    </style>
</resources>